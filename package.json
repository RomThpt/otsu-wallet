{
  "name": "otsu",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:components": "vitest run --config packages/extension/vitest.config.ts",
    "lint": "eslint packages/",
    "format": "prettier --write \"packages/*/src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,vue}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,vue}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@otsu/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.5.5",
      "shell-quote": ">=1.8.4"
    }
  }
}
